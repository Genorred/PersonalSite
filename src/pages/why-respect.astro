---
import Layout from "../layouts/Layout.astro";
import JsPortfolioJonkler from "../components/JsPortfolioJonkler.astro";
import RealPortfolio from "../components/RealPortfolio.astro";
import WhySoSeriousFinal from "../components/WhySoSeriousFinal.astro";
---
<Layout>
  <div id="JsPortfolioJonkler">
    <JsPortfolioJonkler />
  </div>
  <div id="RealPortfolio">
    <RealPortfolio />
  </div>
  <div id="WhySoSeriousFinal">
    <WhySoSeriousFinal />
  </div>
</Layout>
<script>
  const jsPortfolioJonkler = document.getElementById("JsPortfolioJonkler");
  const realPortfolio = document.getElementById("RealPortfolio");
  const whySoSeriousFinal = document.getElementById("WhySoSeriousFinal");

  if (jsPortfolioJonkler) {
    setTimeout(() => {
      jsPortfolioJonkler.remove();
    }, 3500);
  }
  if (realPortfolio) {
    setTimeout(() => {
      realPortfolio.style.display = "block";
    }, 4850);
  }
  if (whySoSeriousFinal) {
    setTimeout(() => {
      whySoSeriousFinal.style.display = "flex";
    }, 7500);
  }
</script>
<style>
  #RealPortfolio {
    display: none;
  }
  #WhySoSeriousFinal {
    display: none;
  }
</style>
